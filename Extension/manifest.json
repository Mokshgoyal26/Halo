{
    "manifest_version":3,
    "name": "Halo (v0)",
    "description": "Experimental floating sidebar window with page context",
    "version":"0.0.1",

    "action":{
        "default_title":"Halo(v0)"
    },

    "permissions":[],

    "background":{
        "service_worker":"service-worker/background.js"
    },

    "content_scripts":[{
        "matches":["<all_urls>"],
        "js":["content-scripts/script.js"],
        "run_at":"document_idle"
    }],

    "web_accessible_resources":[
        {

            "resources":[
                            "content-scripts/sidebar.html",
                            "content-scripts/sidebar.css",
                            "assets/sidebar-logo(2).png",
                            "assets/empty-state-logo.png",
                            "assets/close-button-2.svg"
                        ],
                        
            "matches":["<all_urls>"]
        }
    
    ]

}